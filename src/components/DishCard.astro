---
// Карточка блюда с фото (главная, блок «Хиты»). Кнопки «+» используют ту же разметку .buy, что и меню —
// корзина (Cart.astro) подхватывает их автоматически.
const { item, delay = 0 } = Astro.props;
const fmt = (n) => n.toLocaleString('ru-RU');
const cartName = (v) => (v.label ? `${item.fullName} · ${v.label}` : item.fullName);
// заменить на реальное фото: поле "photo" у блюда в src/data/menu.json, файл 800×600 WebP в public/img/dishes/
const photo = item.photo ?? '/img/dish.webp';
---
<article class="card dish-card reveal" style={`--d:${delay}ms`}>
  <div class="media">
    <img src={photo} alt={item.fullName} width="800" height="600" loading="lazy" decoding="async" />
  </div>
  <div class="body">
    <h3>{item.fullName}{item.isNew && <span class="tag">NEW</span>}</h3>
    {item.desc && <p class="desc">{item.desc}</p>}
    <div class="buys">
      {item.variants.map((v) => (
        <div class="buy" data-key={v.key} data-name={cartName(v)} data-price={v.price}>
          <span class="vp">{v.label && <small>{v.label}</small>}<b>{fmt(v.price)} ₽</b></span>
          <span class="ctl"><button type="button" class="add" data-act="add" aria-label={`Добавить в корзину: ${cartName(v)}`}>+</button></span>
        </div>
      ))}
    </div>
  </div>
</article>
