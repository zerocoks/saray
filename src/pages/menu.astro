---
<Base title="Меню — Сарай">
  <div class="menu-head">
    <div class="wrap">
      <h1>Меню</h1>
      <p>Выбирайте блюда и добавляйте в корзину — оформим доставку или самовывоз.</p>
    </div>
  </div>

  <div class="menu-tools">
    <div class="wrap tools-row">
      <div class="segbtn" id="menu-filters">
        <button type="button" aria-pressed="true" data-filter="all">Все</button>
        <button type="button" aria-pressed="false" data-filter="kitchen">Кухня</button>
        <button type="button" aria-pressed="false" data-filter="bar">Бар</button>
      </div>
      <div class="search">
        <input type="search" id="menu-search" placeholder="Найти блюдо: плов, хачапури, лимонад..." aria-label="Поиск по меню">
      </div>
    </div>
  </div>

  <div class="menu-nav">
    <div class="wrap">
      <div class="chips">
        {menu.map(section => (
          <a href={`#${section.id}`}>{section.title}</a>
        ))}
      </div>
    </div>
  </div>

  <div class="menu-part">
    <div class="wrap">
      <h2>Меню ресторана</h2>
      <p class="sub">Цены указаны в рублях</p>

      {menu.map(section => (
        <section class="cat" id={section.id} data-type={section.type}>
          <h2>{section.title}</h2>
          <ul class="items">
            {section.items.map((item, i) => (
              <li class="item">
                <div class="info">
                  <h3>{item.name} {item.isNew && <span class="tag">NEW</span>}</h3>
                  {item.desc && <p class="desc">{item.desc}</p>}
                </div>
                <div class="side">
                  <div class="buy" data-key={`${section.id}.${i}`} data-name={item.name} data-price={item.price}>
                    <span class="vp"><b>{item.price} ₽</b></span>
                    <span class="ctl">
                      <button type="button" class="add" data-act="add" aria-label="Добавить в корзину: {item.name}">+</button>
                    </span>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>

  <script>
    (function() {
      var filterBtns = document.querySelectorAll('#menu-filters button');
      var searchInput = document.getElementById('menu-search');
      var sections = document.querySelectorAll('section.cat');
      var items = document.querySelectorAll('.item');
      var menuNav = document.querySelector('.menu-nav'); 

      filterBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          filterBtns.forEach(function(b) { b.setAttribute('aria-pressed', 'false'); });
          btn.setAttribute('aria-pressed', 'true');
          
          var filter = btn.dataset.filter;
          
          sections.forEach(function(sec) {
            if (filter === 'all' || sec.dataset.type === filter) {
              sec.hidden = false;
            } else {
              sec.hidden = true;
            }
          });

          if (filter === 'bar') {
            menuNav.classList.add('is-hidden');
          } else {
            menuNav.classList.remove('is-hidden');
          }
        });
      });

      searchInput.addEventListener('input', function(e) {
        var query = e.target.value.toLowerCase().trim();
        
        items.forEach(function(item) {
          var title = item.querySelector('h3').textContent.toLowerCase();
          if (title.includes(query)) {
            item.hidden = false;
          } else {
            item.hidden = true;
          }
        });

        sections.forEach(function(sec) {
          if (sec.hidden && query === '') return;
          var visibleItems = sec.querySelectorAll('.item:not([hidden])');
          if (visibleItems.length === 0 && query !== '') {
            sec.hidden = true;
          } else {
            sec.hidden = false;
          }
        });
      });
    })();
  </script>
</Base>