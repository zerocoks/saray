---
import '../styles/global.css';
import Cart from '../components/Cart.astro';

const { title = "Сарай — ресторан в Новосибирске", description = "Ресторан «Сарай» на Дачной, 19: шашлык, плов, хачапури, банкеты и доставка." } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#141210">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  
  <link rel="icon" type="image/png" href="/img/favicon-black.png" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500&family=Playfair+Display:wght@400&display=swap&subset=cyrillic" rel="stylesheet">
  <script>document.documentElement.classList.add('js')</script>
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"Restaurant","name":"Сарай","telephone":"+7 383 225-11-25","url":"https://saray.su","hasMenu":"https://saray.su/menu","address":{"@type":"PostalAddress","streetAddress":"ул. Дачная, 19","addressLocality":"Новосибирск","addressCountry":"RU"}}
  </script>
</head>
<body>
  <a class="skip" href="#main">К содержимому</a>
  
  <header>
    <div class="wrap">
      <a class="logo" href="/">
        <img src="/img/logo.png" alt="Сарай" />
        <span>Сарай</span>
      </a>
      
      <nav id="nav" aria-label="Основное меню">
        <a href="/menu">Меню</a>
        <a href="/#atmosfera">Атмосфера</a>
        <a href="/#akcii">Акции</a>
        <a href="/#kontakty">Контакты</a>
        <a href="tel:+73832251125">+7 (383) 225-11-25</a>
        <a class="nav-cta" href="/#bron">Забронировать</a>
      </nav>
      <div class="hdr-actions">
        <button type="button" class="cart-btn" data-act="open-cart" aria-label="Открыть корзину">
          Корзина<span class="cart-count" hidden>0</span>
        </button>
        <button type="button" class="burger" id="burger" aria-expanded="false" aria-controls="nav" aria-label="Открыть меню">
          <span></span>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <Cart />
  
  <footer>
    <div class="wrap">
      <p>
        г. Новосибирск, ул. Дачная, 19, 1 этаж · 
        <a href="tel:+73832251125">+7 (383) 225-11-25</a> · 
        <a href="https://vk.com/barak_saray_ambar" target="_blank" rel="noopener">ВКонтакте</a> · 
        <a href="https://www.instagram.com/bar_saray/" target="_blank" rel="noopener">Instagram</a>
      </p>
      <p><a href="/privacy">Политика обработки персональных данных</a></p>
    </div>
  </footer>

  <script>
    // 1. Логика мобильного меню (бургер)
    (function () {
      var h = document.querySelector('header'), b = document.getElementById('burger');
      if (!b) return;
      function set(open) { 
        h.classList.toggle('open', open); 
        b.setAttribute('aria-expanded', String(open)); 
        b.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню'); 
      }
      b.addEventListener('click', function () { set(!h.classList.contains('open')); });
      var nav = document.getElementById('nav');
      if (nav) {
        nav.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
      }
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
      document.addEventListener('click', function (e) { if (!e.target.closest('header')) set(false); });
      matchMedia('(min-width: 901px)').addEventListener('change', function (m) { if (m.matches) set(false); });
    })();

    // 2. Плавное появление блоков (.reveal) при прокрутке
    (function () {
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) { 
        els.forEach(function (e) { e.classList.add('in'); }); 
        return; 
      }
      var io = new IntersectionObserver(function (list) {
        list.forEach(function (x) { 
          if (x.isIntersecting) { 
            x.target.classList.add('in'); 
            io.unobserve(x.target); 
          } 
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      
      els.forEach(function (e) { io.observe(e); });
    })();

    // 3. Новые эффекты: Параллакс, Умная шапка, Магнитные кнопки
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var header = document.querySelector('header');
      var heroImg = document.querySelector('.hero-img');
      var lastScroll = 0;
      var ticking = false;

      window.addEventListener('scroll', function () {
        if (!ticking) {
          window.requestAnimationFrame(function () {
            var currentScroll = window.scrollY;

            if (currentScroll > 50) { header.classList.add('is-scrolled'); } 
            else { header.classList.remove('is-scrolled'); }

            if (currentScroll > lastScroll && currentScroll > 200) { 
              header.classList.add('is-hidden'); 
              document.body.classList.add('header-hidden'); 
            } else { 
              header.classList.remove('is-hidden'); 
              document.body.classList.remove('header-hidden'); 
            }

            if (heroImg && currentScroll < window.innerHeight) {
              heroImg.style.transform = 'translateY(' + (currentScroll * 0.4) + 'px) scale(1.05)';
            }
            
            lastScroll = currentScroll;
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });

      if (window.matchMedia('(hover: hover)').matches) {
        var magnets = document.querySelectorAll('.btn.fill, .nav-cta');
        magnets.forEach(function (btn) {
          btn.addEventListener('mousemove', function (e) {
            var rect = btn.getBoundingClientRect();
            var x = e.clientX - rect.left - rect.width / 2;
            var y = e.clientY - rect.top - rect.height / 2;
            btn.style.transform = 'translate(' + (x * 0.2) + 'px, ' + (y * 0.2) + 'px)';
          });
          btn.addEventListener('mouseleave', function () {
            btn.style.transform = 'translate(0px, 0px)';
          });
        });
      }
    })();
  </script>
</body>
</html>